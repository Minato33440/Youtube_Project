  "sentences": [
    {
      "id": "N01_01",
      "text": "減税をするなら、財源はどうするのか。",
      "spoken_text": "減税をするなら、財源はどうするのか。",
      "duration": 2.8117233560090704,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N01_02",
      "text": "よく聞くこの問いに、会田卓司さんは経済成長という視点から答えています。",
      "spoken_text": "よく聞くこの問いに、あいだたくじさんは経済成長という視点から答えています。",
      "duration": 5.682539682539683,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N01_03",
      "text": "国債への不安と、私たちの暮らしを支える政策は、どうつながるのでしょうか。",
      "spoken_text": "国債への不安と、私たちの暮らしを支える政策は、どうつながるのでしょうか。",
      "duration": 5.403038548752835,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N01_04",
      "text": "発言を順に見ていきます。",
      "spoken_text": "発言を順に見ていきます。",
      "duration": 1.7035827664399092,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N02_01",
      "text": "借換えは、満期の国債に対応して新しい国債を発行する仕組みで、債務が消えるわけではありません。",
      "spoken_text": "借換えは、満期の国債に対応して新しい国債を発行する仕組みで、債務が消えるわけではありません。",
      "duration": 7.309138321995465,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N02_02",
      "text": "ここからは、企業と政府の支出を合わせて見る考え方です。",
      "spoken_text": "ここからは、企業と政府の支出を合わせて見る考え方です。",
      "duration": 4.516893424036281,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N02_03",
      "text": "二千二十五年十一月公開の解説で、経済全体のお金の流れを確認します。",
      "spoken_text": "二千二十五年十一月公開の解説で、経済全体のお金の流れを確認します。",
      "duration": 5.828843537414966,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N03_01",
      "text": "ここでのマイナス五パーセントは、会田さんが示す政策運営の目安です。",
      "spoken_text": "ここでのマイナス五パーセントは、あいださんが示す政策運営の目安です。",
      "duration": 5.35780045351474,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N03_02",
      "text": "輸入物価などの条件も合わせて考える必要があります。",
      "spoken_text": "輸入物価などの条件も合わせて考える必要があります。",
      "duration": 4.339886621315193,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N03_03",
      "text": "では、経済が成長したときの税収は、どう考えるのか。",
      "spoken_text": "では、経済が成長したときの税収は、どう考えるのか。",
      "duration": 4.11031746031746,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N03_04",
      "text": "次は、減税の財源についての対談です。",
      "spoken_text": "次は、減税の財源についての対談です。",
      "duration": 3.5113151927437642,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N04_01",
      "text": "投資を増やしても、すぐに給料が上がるとは限りません。",
      "spoken_text": "投資を増やしても、すぐに給料が上がるとは限りません。",
      "duration": 3.662766439909297,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N04_02",
      "text": "その間の暮らしをどう支えるのか。",
      "spoken_text": "その間の暮らしをどう支えるのか。",
      "duration": 2.2217006802721087,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N04_03",
      "text": "減税の具体的な方法では、二人の意見の違いにも注目してください。",
      "spoken_text": "減税の具体的な方法では、二人の意見の違いにも注目してください。",
      "duration": 5.193854875283447,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_01",
      "text": "今回のポイントは、三つです。",
      "spoken_text": "今回のポイントは、三つです。",
      "duration": 2.262380952380952,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_02",
      "text": "一つ目は、国債の残高だけでなく、何に使い、将来の所得につながるかを見ること。",
      "spoken_text": "一つ目は、国債の残高だけでなく、何に使い、将来の所得につながるかを見ること。",
      "duration": 6.528185941043084,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_03",
      "text": "二つ目は、経済成長と税収、そして家計の負担を、つなげて考えること。",
      "spoken_text": "二つ目は、経済成長と税収、そして家計の負担を、つなげて考えること。",
      "duration": 6.1768707482993195,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_04",
      "text": "三つ目は、投資の成果が届くまで、暮らしを支えることです。",
      "spoken_text": "三つ目は、投資の成果が届くまで、暮らしを支えることです。",
      "duration": 4.38265306122449,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_05",
      "text": "会田さんは、企業と政府の支出に注目して、成長と家計支援を進める道筋を示しています。",
      "spoken_text": "あいださんは、企業と政府の支出に注目して、成長と家計支援を進める道筋を示しています。",
      "duration": 7.1013151927437645,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_06",
      "text": "ただし、物価や金利への影響、投資の成果、予算が実行されるかも確かめる必要があります。",
      "spoken_text": "ただし、物価や金利への影響、投資の成果、予算が実行されるかも確かめる必要があります。",
      "duration": 7.257709750566893,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_07",
      "text": "財源があるかという問いから、成長の力をどう暮らしへ届けるかへ。",
      "spoken_text": "財源があるかという問いから、成長の力をどう暮らしへ届けるかへ。",
      "duration": 4.821133786848073,
      "peak_dbfs": -0.00026507636037961915,
      "full_scale_samples": 1
    },
    {
      "id": "N05_08",
      "text": "今回の発言を、その視点から考えてみてください。",
      "spoken_text": "今回の発言を、その視点から考えてみてください。",
